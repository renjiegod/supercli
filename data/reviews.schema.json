{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "repo",
      "docs",
      "install",
      "reviewedAt",
      "reviewer",
      "evidence",
      "checks",
      "name",
      "vendor",
      "maintainerType",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "repo": {
        "type": ["string", "null"]
      },
      "docs": {
        "type": "string"
      },
      "install": {
        "type": ["string", "null"]
      },
      "reviewedAt": {
        "type": "string"
      },
      "reviewer": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$"
      },
      "evidence": {
        "type": "string",
        "pattern": "^https://github\\.com/webkubor/supercli/pull/[1-9][0-9]*(#pullrequestreview-[0-9]+)?$"
      },
      "checks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "method",
            "reference",
            "note",
            "environment",
            "version"
          ],
          "properties": {
            "kind": {
              "enum": ["source", "installation", "purpose", "maintenance"]
            },
            "method": {
              "enum": ["documentation", "execution"]
            },
            "reference": {
              "type": "string",
              "pattern": "^https://[^\\s<>\"']+$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "environment": {
              "type": ["string", "null"]
            },
            "version": {
              "type": ["string", "null"]
            }
          },
          "if": {
            "properties": {
              "method": {
                "const": "execution"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "installation"
              },
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "name": {
        "type": "string"
      },
      "vendor": {
        "type": "string"
      },
      "maintainerType": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    }
  }
}
