{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "vendor",
      "category",
      "repo",
      "description",
      "install",
      "docs",
      "icon",
      "maintainerType"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "vendor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "category": {
        "enum": ["cloud", "ai", "dev", "terminal", "data", "media", "security"]
      },
      "repo": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160
      },
      "install": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[^\\n\\r<>]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "docs": {
        "type": "string",
        "pattern": "^https://[^\\s<>\"']+$"
      },
      "icon": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.(png|svg)$"
      },
      "locallyInstalled": {
        "type": "boolean"
      },
      "maintainerType": {
        "enum": ["vendor", "community"]
      }
    }
  }
}
