{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task", "fit", "requirements", "caveat", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "$ref": "#/$defs/text"
        },
        "fit": {
          "$ref": "#/$defs/text"
        },
        "requirements": {
          "$ref": "#/$defs/text"
        },
        "caveat": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "slug",
      "category",
      "reviewedAt",
      "title",
      "summary",
      "answer",
      "boundary",
      "steps",
      "tools"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "reviewedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "title": {
        "$ref": "#/$defs/text"
      },
      "summary": {
        "$ref": "#/$defs/text"
      },
      "answer": {
        "$ref": "#/$defs/text"
      },
      "boundary": {
        "$ref": "#/$defs/text"
      },
      "steps": {
        "type": "array",
        "minItems": 3,
        "items": {
          "$ref": "#/$defs/text"
        }
      },
      "tools": {
        "type": "array",
        "minItems": 2,
        "items": {
          "$ref": "#/$defs/tool"
        }
      }
    }
  }
}
